bool FarmLooksLikeUlid(const string s)
{
   if(StringLen(s) != 26) return false;
   const string alphabet = "0123456789ABCDEFGHJKMNPQRSTVWXYZ";
   for(int i = 0; i < StringLen(s); i++)
   {
      if(StringFind(alphabet, ShortToString(StringGetCharacter(s, i))) < 0)
         return false;
   }
   return true;
}

bool FarmLooksLikeSymbol(const string s)
{
   if(StringLen(s) < 3 || StringLen(s) > 24) return false;
   int dot_count = 0;
   int dot_pos = -1;
   for(int i = 0; i < StringLen(s); i++)
   {
      const ushort ch = StringGetCharacter(s, i);
      const bool upper_digit = (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9');
      const bool suffix = (ch >= 'a' && ch <= 'z') || upper_digit;
      if(ch == '.') { dot_count++; dot_pos = i; continue; }
      if(dot_count == 0 && !upper_digit) return false;
      if(dot_count > 0 && !suffix) return false;
   }
   if(dot_count > 1) return false;
   if(dot_count == 1 && (dot_pos < 3 || StringLen(s) - dot_pos - 1 < 1 || StringLen(s) - dot_pos - 1 > 8)) return false;
   if(dot_count == 0 && StringLen(s) > 15) return false;
   return true;
}

bool FarmLooksLikeTsUtc(const string s)
{
   const int n = StringLen(s);
   if(n != 20 && n < 22) return false;
   if(StringGetCharacter(s, n - 1) != 'Z') return false;
   if(StringFind(s, "+") >= 0) return false;
   if(StringGetCharacter(s, 4) != '-' || StringGetCharacter(s, 7) != '-' || StringGetCharacter(s, 10) != 'T') return false;
   if(StringGetCharacter(s, 13) != ':' || StringGetCharacter(s, 16) != ':') return false;
   if(n == 20) return true;
   if(StringGetCharacter(s, 19) != '.') return false;
   const int frac = n - 21;
   return frac >= 1 && frac <= 3;
}

