   string required[] = {"v","type","msg_id","session_id","ts_server","ts_sent","payload"};
   if(!FarmRequireKeys(root, required)) return false;
   CFarmJsonValue *v = root.Get("v");
   CFarmJsonValue *type = root.Get("type");
   CFarmJsonValue *msg_id = root.Get("msg_id");
   CFarmJsonValue *session_id = root.Get("session_id");
   CFarmJsonValue *ts_server = root.Get("ts_server");
   CFarmJsonValue *ts_sent = root.Get("ts_sent");
   CFarmJsonValue *payload = root.Get("payload");
   if(v.type != FARM_JSON_NUMBER || v.integer_value != 1) { FarmJsonSetError("BAD_FIELD", "v"); return false; }
   if(type.type != FARM_JSON_STRING) { FarmJsonSetError("BAD_FIELD", "type"); return false; }
   if(msg_id.type != FARM_JSON_STRING || !FarmLooksLikeUlid(msg_id.string_value)) { FarmJsonSetError("BAD_FIELD", "msg_id"); return false; }
   if(session_id.type != FARM_JSON_STRING || StringFind(session_id.string_value, "PERIOD_") >= 0) { FarmJsonSetError("BAD_FIELD", "session_id"); return false; }
   if(ts_server.type != FARM_JSON_STRING || !FarmLooksLikeTsUtc(ts_server.string_value)) { FarmJsonSetError("BAD_FIELD", "ts_server"); return false; }
   if(ts_sent.type != FARM_JSON_STRING || !FarmLooksLikeTsUtc(ts_sent.string_value)) { FarmJsonSetError("BAD_FIELD", "ts_sent"); return false; }
   if(payload.type != FARM_JSON_OBJECT) { FarmJsonSetError("BAD_FIELD", "payload"); return false; }
   out.v = 1;
   out.type_raw = type.string_value;
   out.type = FarmMsgTypeFromString(out.type_raw);
   out.msg_id = msg_id.string_value;
   out.session_id = session_id.string_value;
   out.ts_server = ts_server.string_value;
   out.ts_sent = ts_sent.string_value;
   out.payload_json = payload.ToJson();
   return true;
}

