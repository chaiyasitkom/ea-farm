bool FarmSerializeEnvelope(const FarmEnvelope &src, string &out_line)
{
   const string type = (src.type == FARM_MSG_UNKNOWN ? src.type_raw : FarmMsgTypeToString(src.type));
   out_line = "{"
      + "\"v\":" + IntegerToString(src.v)
      + ",\"type\":" + FarmJsonQuoteUtf8(type)
      + ",\"msg_id\":" + FarmJsonQuoteUtf8(src.msg_id)
      + ",\"session_id\":" + FarmJsonQuoteUtf8(src.session_id)
      + ",\"ts_server\":" + FarmJsonQuoteUtf8(src.ts_server)
      + ",\"ts_sent\":" + FarmJsonQuoteUtf8(src.ts_sent)
      + ",\"payload\":" + src.payload_json + "}";
   return true;
}

bool FarmValidateState(CFarmJsonValue *payload)
{
   string required[] = {"balance","equity","margin_used","margin_free","margin_level_pct","equity_hwm","day_start_equity","day_pl","day_pl_pct","positions","pending_orders","owned_net","owned_ticket_count","foreign_positions","account_margin_mode","guard"};
   if(!FarmRequireKeys(payload, required)) return false;
   CFarmJsonValue *positions = payload.Get("positions");
   if(positions.type != FARM_JSON_ARRAY) { FarmJsonSetError("BAD_FIELD", "positions"); return false; }
   for(int i = 0; i < positions.Size(); i++)
   {
      CFarmJsonValue *pos = positions.At(i);
      if(pos == NULL || pos.type != FARM_JSON_OBJECT) { FarmJsonSetError("BAD_FIELD", "positions[]"); return false; }
      string pos_required[] = {"ticket","symbol","side","volume","price_open","sl","tp","profit","swap","magic","time_open"};
      if(!FarmRequireKeys(pos, pos_required)) return false;
      CFarmJsonValue *sl = pos.Get("sl");
      if(sl.type == FARM_JSON_NUMBER && sl.number_value <= 0.0) { FarmJsonSetError("BAD_FIELD", "sl"); return false; }
      CFarmJsonValue *comment = pos.Get("comment");
      if(comment != NULL && comment.type != FARM_JSON_NULL && comment.type != FARM_JSON_STRING) { FarmJsonSetError("BAD_FIELD", "comment"); return false; }
   }
   CFarmJsonValue *owned_net = payload.Get("owned_net");
   if(owned_net.type != FARM_JSON_OBJECT) { FarmJsonSetError("BAD_FIELD", "owned_net"); return false; }
   for(int i = 0; i < owned_net.Size(); i++)
   {
      if(!FarmLooksLikeSymbol(owned_net.KeyAt(i))) { FarmJsonSetError("BAD_FIELD", "owned_net"); return false; }
   }
   return true;
}

bool FarmValidatePayload(const ENUM_FARM_MSG_TYPE msg_type, CFarmJsonValue *payload)
{
   if(payload == NULL || payload.type != FARM_JSON_OBJECT) { FarmJsonSetError("EXPECTED_OBJECT", "payload"); return false; }
   if(msg_type == FARM_MSG_UNKNOWN) return true;
   if(msg_type == FARM_MSG_BAR)
   {
      if(!FarmRequireObjectKey(payload, "is_final")) return false;
      CFarmJsonValue *is_final = payload.Get("is_final");
      if(is_final.type != FARM_JSON_BOOL || !is_final.bool_value) { FarmJsonSetError("BAD_FIELD", "is_final"); return false; }
   }
   if(msg_type == FARM_MSG_HELLO)
   {
      if(!FarmRequireObjectKey(payload, "token")) return false;
      CFarmJsonValue *account = payload.Get("account");
      if(account != NULL && account.type == FARM_JSON_OBJECT)
      {
         CFarmJsonValue *mode = account.Get("margin_mode");
         if(mode != NULL && mode.type == FARM_JSON_STRING && mode.string_value == "retail_hedging") { FarmJsonSetError("BAD_FIELD", "account.margin_mode"); return false; }
      }
   }
   if(msg_type == FARM_MSG_STATE && !FarmValidateState(payload)) return false;
   if(msg_type == FARM_MSG_RISK_DIRECTIVE)
   {
      if(!FarmRequireObjectKey(payload, "scale_factor")) return false;
      CFarmJsonValue *scale = payload.Get("scale_factor");
      if(scale.type != FARM_JSON_NUMBER || scale.number_value < 0.0 || scale.number_value > 1.0) { FarmJsonSetError("BAD_FIELD", "scale_factor"); return false; }
   }
   if(msg_type == FARM_MSG_CONFIG_UPDATE)
   {
      CFarmJsonValue *settings = payload.Get("settings");
      if(settings == NULL || settings.type != FARM_JSON_OBJECT) { FarmJsonSetError("MISSING_REQUIRED", "settings"); return false; }
      for(int i = 0; i < settings.Size(); i++)
      {
         const string key = settings.KeyAt(i);
         if(key != "verbose_log" && key != "heartbeat_sec" && key != "state_interval_sec" && key != "bar_backfill_count") { FarmJsonSetError("UNKNOWN_FIELD", "settings." + key); return false; }
      }
   }
   return true;
}

bool FarmParsePayloadJson(const ENUM_FARM_MSG_TYPE msg_type, const string json, string &out_json)
{
   CFarmJsonDoc doc;
   if(!doc.Parse(json)) return false;
   if(!FarmValidatePayload(msg_type, doc.Root())) { doc.Free(); return false; }
   out_json = doc.Root().ToJson();
   doc.Free();
   return true;
}

bool FarmParseState(const string json, FarmStatePayload &out)
{
   CFarmJsonDoc doc;
   if(!doc.Parse(json)) return false;
   if(!FarmValidateState(doc.Root())) { doc.Free(); return false; }
   out.raw_json = doc.Root().ToJson();
   CFarmJsonValue *ml = doc.Root().Get("margin_level_pct");
   out.margin_level_pct_present = (ml != NULL);
   out.margin_level_pct_is_null = (ml != NULL && ml.type == FARM_JSON_NULL);
   out.margin_level_pct = (ml != NULL && ml.type == FARM_JSON_NUMBER ? ml.number_value : 0.0);
   doc.Free();
   return true;
}

