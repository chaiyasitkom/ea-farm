   if(ts_server.type != FARM_JSON_STRING || !FarmLooksLikeTsUtc(ts_server.string_value)) { FarmJsonSetError("BAD_FIELD", "ts_server"); return false; }
   if(ts_sent.type != FARM_JSON_STRING || !FarmLooksLikeTsUtc(ts_sent.string_value)) { FarmJsonSetError("BAD_FIELD", "ts_sent"); return false; }
   if(payload.type != FARM_JSON_OBJECT) { FarmJsonSetError("BAD_FIELD", "payload"); return false; }
   out.v = 1;
   out.type_raw = type.string_value;
   out.type = FarmMsgTypeFromString(out.type_raw);
   out.msg_id = msg_id.string_value;
   out.session_id = session_id.string_value;
   out.ts_server = ts_server.string_value;
   out.ts_sent = ts_sent.string_value;
