string FarmMsgTypeToString(const ENUM_FARM_MSG_TYPE v)
{
   switch(v)
   {
      case FARM_MSG_HELLO: return "HELLO";
      case FARM_MSG_HELLO_ACK: return "HELLO_ACK";
      case FARM_MSG_HEARTBEAT: return "HEARTBEAT";
      case FARM_MSG_HEARTBEAT_ACK: return "HEARTBEAT_ACK";
      case FARM_MSG_BAR: return "BAR";
      case FARM_MSG_STATE: return "STATE";
      case FARM_MSG_INTENT: return "INTENT";
      case FARM_MSG_INTENT_ACK: return "INTENT_ACK";
      case FARM_MSG_EXEC_REPORT: return "EXEC_REPORT";
      case FARM_MSG_RISK_DIRECTIVE: return "RISK_DIRECTIVE";
      case FARM_MSG_CONFIG_UPDATE: return "CONFIG_UPDATE";
      case FARM_MSG_ERROR: return "ERROR";
      default: return "UNKNOWN";
   }
}

ENUM_FARM_MSG_TYPE FarmMsgTypeFromString(const string s)
{
   if(s == "HELLO") return FARM_MSG_HELLO;
   if(s == "HELLO_ACK") return FARM_MSG_HELLO_ACK;
   if(s == "HEARTBEAT") return FARM_MSG_HEARTBEAT;
   if(s == "HEARTBEAT_ACK") return FARM_MSG_HEARTBEAT_ACK;
   if(s == "BAR") return FARM_MSG_BAR;
   if(s == "STATE") return FARM_MSG_STATE;
   if(s == "INTENT") return FARM_MSG_INTENT;
   if(s == "INTENT_ACK") return FARM_MSG_INTENT_ACK;
   if(s == "EXEC_REPORT") return FARM_MSG_EXEC_REPORT;
   if(s == "RISK_DIRECTIVE") return FARM_MSG_RISK_DIRECTIVE;
   if(s == "CONFIG_UPDATE") return FARM_MSG_CONFIG_UPDATE;
   if(s == "ERROR") return FARM_MSG_ERROR;
   return FARM_MSG_UNKNOWN;
}

bool FarmLooksLikeUlid(const string s)
{
   if(StringLen(s) != 26) return false;
   const string alphabet = "0123456789ABCDEFGHJKMNPQRSTVWXYZ";
   for(int i = 0; i < StringLen(s); i++)
   {
      if(StringFind(alphabet, ShortToString(StringGetCharacter(s, i))) < 0)
         return false;
   }
   return true;
}

bool FarmLooksLikeSymbol(const string s)
{
   if(StringLen(s) < 3 || StringLen(s) > 24) return false;
   int dot_count = 0;
   int dot_pos = -1;
   for(int i = 0; i < StringLen(s); i++)
   {
      const ushort ch = StringGetCharacter(s, i);
      const bool upper_digit = (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9');
      const bool suffix = (ch >= 'a' && ch <= 'z') || upper_digit;
      if(ch == '.') { dot_count++; dot_pos = i; continue; }
      if(dot_count == 0 && !upper_digit) return false;
      if(dot_count > 0 && !suffix) return false;
   }
   if(dot_count > 1) return false;
   if(dot_count == 1 && (dot_pos < 3 || StringLen(s) - dot_pos - 1 < 1 || StringLen(s) - dot_pos - 1 > 8)) return false;
   if(dot_count == 0 && StringLen(s) > 15) return false;
   return true;
}

bool FarmLooksLikeTsUtc(const string s)
{
   const int n = StringLen(s);
   if(n != 20 && n < 22) return false;
   if(StringGetCharacter(s, n - 1) != 'Z') return false;
   if(StringFind(s, "+") >= 0) return false;
   if(StringGetCharacter(s, 4) != '-' || StringGetCharacter(s, 7) != '-' || StringGetCharacter(s, 10) != 'T') return false;
   if(StringGetCharacter(s, 13) != ':' || StringGetCharacter(s, 16) != ':') return false;
   if(n == 20) return true;
   if(StringGetCharacter(s, 19) != '.') return false;
   const int frac = n - 21;
   return frac >= 1 && frac <= 3;
}

bool FarmRequireObjectKey(CFarmJsonValue *obj, const string key)
{
   if(obj == NULL || obj.type != FARM_JSON_OBJECT || !obj.Has(key))
   {
      FarmJsonSetError("MISSING_REQUIRED", key);
      return false;
   }
   return true;
}

bool FarmRequireKeys(CFarmJsonValue *obj, const string &keys[])
{
   string missing = "";
   for(int i = 0; i < ArraySize(keys); i++)
   {
      if(obj == NULL || obj.type != FARM_JSON_OBJECT || !obj.Has(keys[i]))
      {
         if(missing != "") missing += ",";
         missing += keys[i];
      }
   }
   if(missing != "")
   {
      FarmJsonSetError("MISSING_REQUIRED", missing);
      return false;
   }
   return true;
}

bool FarmValidateEnvelopeDoc(CFarmJsonValue *root, FarmEnvelope &out)
{
   if(root == NULL || root.type != FARM_JSON_OBJECT) { FarmJsonSetError("EXPECTED_OBJECT", "envelope"); return false; }
   string required[] = {"v","type","msg_id","session_id","ts_server","ts_sent","payload"};
   if(!FarmRequireKeys(root, required)) return false;
   CFarmJsonValue *v = root.Get("v");
   CFarmJsonValue *type = root.Get("type");
   CFarmJsonValue *msg_id = root.Get("msg_id");
   CFarmJsonValue *session_id = root.Get("session_id");
   CFarmJsonValue *ts_server = root.Get("ts_server");
   CFarmJsonValue *ts_sent = root.Get("ts_sent");
   CFarmJsonValue *payload = root.Get("payload");
   if(v.type != FARM_JSON_NUMBER || v.integer_value != 1) { FarmJsonSetError("BAD_FIELD", "v"); return false; }
   if(type.type != FARM_JSON_STRING) { FarmJsonSetError("BAD_FIELD", "type"); return false; }
   if(msg_id.type != FARM_JSON_STRING || !FarmLooksLikeUlid(msg_id.string_value)) { FarmJsonSetError("BAD_FIELD", "msg_id"); return false; }
   if(session_id.type != FARM_JSON_STRING || StringFind(session_id.string_value, "PERIOD_") >= 0) { FarmJsonSetError("BAD_FIELD", "session_id"); return false; }
   if(ts_server.type != FARM_JSON_STRING || !FarmLooksLikeTsUtc(ts_server.string_value)) { FarmJsonSetError("BAD_FIELD", "ts_server"); return false; }
   if(ts_sent.type != FARM_JSON_STRING || !FarmLooksLikeTsUtc(ts_sent.string_value)) { FarmJsonSetError("BAD_FIELD", "ts_sent"); return false; }
   if(payload.type != FARM_JSON_OBJECT) { FarmJsonSetError("BAD_FIELD", "payload"); return false; }
   out.v = 1;
   out.type_raw = type.string_value;
   out.type = FarmMsgTypeFromString(out.type_raw);
   out.msg_id = msg_id.string_value;
   out.session_id = session_id.string_value;
   out.ts_server = ts_server.string_value;
   out.ts_sent = ts_sent.string_value;
   out.payload_json = payload.ToJson();
   return true;
}

bool FarmParseEnvelope(const string line, FarmEnvelope &out)
{
   CFarmJsonDoc doc;
   if(!doc.Parse(line)) return false;
   const bool ok = FarmValidateEnvelopeDoc(doc.Root(), out);
   doc.Free();
   return ok;
}

bool FarmSerializeEnvelope(const FarmEnvelope &src, string &out_line)
{
   const string type = (src.type == FARM_MSG_UNKNOWN ? src.type_raw : FarmMsgTypeToString(src.type));
   out_line = "{"
      + "\"v\":" + IntegerToString(src.v)
      + ",\"type\":" + FarmJsonQuoteUtf8(type)
      + ",\"msg_id\":" + FarmJsonQuoteUtf8(src.msg_id)
      + ",\"session_id\":" + FarmJsonQuoteUtf8(src.session_id)
      + ",\"ts_server\":" + FarmJsonQuoteUtf8(src.ts_server)
      + ",\"ts_sent\":" + FarmJsonQuoteUtf8(src.ts_sent)
      + ",\"payload\":" + src.payload_json + "}";
   return true;
}

bool FarmValidateState(CFarmJsonValue *payload)
{
   string required[] = {"balance","equity","margin_used","margin_free","margin_level_pct","equity_hwm","day_start_equity","day_pl","day_pl_pct","positions","pending_orders","owned_net","owned_ticket_count","foreign_positions","account_margin_mode","guard"};
   if(!FarmRequireKeys(payload, required)) return false;
   CFarmJsonValue *positions = payload.Get("positions");
   if(positions.type != FARM_JSON_ARRAY) { FarmJsonSetError("BAD_FIELD", "positions"); return false; }
   for(int i = 0; i < positions.Size(); i++)
   {
      CFarmJsonValue *pos = positions.At(i);
      if(pos == NULL || pos.type != FARM_JSON_OBJECT) { FarmJsonSetError("BAD_FIELD", "positions[]"); return false; }
      string pos_required[] = {"ticket","symbol","side","volume","price_open","sl","tp","profit","swap","magic","time_open"};
      if(!FarmRequireKeys(pos, pos_required)) return false;
      CFarmJsonValue *sl = pos.Get("sl");
      if(sl.type == FARM_JSON_NUMBER && sl.number_value <= 0.0) { FarmJsonSetError("BAD_FIELD", "sl"); return false; }
      CFarmJsonValue *comment = pos.Get("comment");
      if(comment != NULL && comment.type != FARM_JSON_NULL && comment.type != FARM_JSON_STRING) { FarmJsonSetError("BAD_FIELD", "comment"); return false; }
   }
   CFarmJsonValue *owned_net = payload.Get("owned_net");
   if(owned_net.type != FARM_JSON_OBJECT) { FarmJsonSetError("BAD_FIELD", "owned_net"); return false; }
   for(int i = 0; i < owned_net.Size(); i++)
   {
      if(!FarmLooksLikeSymbol(owned_net.KeyAt(i))) { FarmJsonSetError("BAD_FIELD", "owned_net"); return false; }
   }
   return true;
}

bool FarmValidatePayload(const ENUM_FARM_MSG_TYPE msg_type, CFarmJsonValue *payload)
{
   if(payload == NULL || payload.type != FARM_JSON_OBJECT) { FarmJsonSetError("EXPECTED_OBJECT", "payload"); return false; }
   if(msg_type == FARM_MSG_UNKNOWN) return true;
   if(msg_type == FARM_MSG_BAR)
   {
      if(!FarmRequireObjectKey(payload, "is_final")) return false;
      CFarmJsonValue *is_final = payload.Get("is_final");
      if(is_final.type != FARM_JSON_BOOL || !is_final.bool_value) { FarmJsonSetError("BAD_FIELD", "is_final"); return false; }
   }
   if(msg_type == FARM_MSG_HELLO)
   {
      if(!FarmRequireObjectKey(payload, "token")) return false;
      CFarmJsonValue *account = payload.Get("account");
      if(account != NULL && account.type == FARM_JSON_OBJECT)
      {
         CFarmJsonValue *mode = account.Get("margin_mode");
         if(mode != NULL && mode.type == FARM_JSON_STRING && mode.string_value == "retail_hedging") { FarmJsonSetError("BAD_FIELD", "account.margin_mode"); return false; }
      }
   }
   if(msg_type == FARM_MSG_STATE && !FarmValidateState(payload)) return false;
   if(msg_type == FARM_MSG_RISK_DIRECTIVE)
   {
      if(!FarmRequireObjectKey(payload, "scale_factor")) return false;
      CFarmJsonValue *scale = payload.Get("scale_factor");
      if(scale.type != FARM_JSON_NUMBER || scale.number_value < 0.0 || scale.number_value > 1.0) { FarmJsonSetError("BAD_FIELD", "scale_factor"); return false; }
   }
   if(msg_type == FARM_MSG_CONFIG_UPDATE)
   {
      CFarmJsonValue *settings = payload.Get("settings");
      if(settings == NULL || settings.type != FARM_JSON_OBJECT) { FarmJsonSetError("MISSING_REQUIRED", "settings"); return false; }
      for(int i = 0; i < settings.Size(); i++)
      {
         const string key = settings.KeyAt(i);
         if(key != "verbose_log" && key != "heartbeat_sec" && key != "state_interval_sec" && key != "bar_backfill_count") { FarmJsonSetError("UNKNOWN_FIELD", "settings." + key); return false; }
      }
   }
   return true;
}

bool FarmParsePayloadJson(const ENUM_FARM_MSG_TYPE msg_type, const string json, string &out_json)
{
   CFarmJsonDoc doc;
   if(!doc.Parse(json)) return false;
   if(!FarmValidatePayload(msg_type, doc.Root())) { doc.Free(); return false; }
   out_json = doc.Root().ToJson();
   doc.Free();
   return true;
}

double FarmJsonNumberValue(CFarmJsonValue *obj, const string key)
{
   CFarmJsonValue *v = obj.Get(key);
   return (v != NULL && v.type == FARM_JSON_NUMBER ? v.number_value : 0.0);
}

long FarmJsonLongValue(CFarmJsonValue *obj, const string key)
{
   CFarmJsonValue *v = obj.Get(key);
   return (v != NULL && v.type == FARM_JSON_NUMBER ? v.integer_value : 0);
}

string FarmJsonStringValue(CFarmJsonValue *obj, const string key)
{
   CFarmJsonValue *v = obj.Get(key);
   return (v != NULL && v.type == FARM_JSON_STRING ? v.string_value : "");
}

bool FarmJsonBoolValue(CFarmJsonValue *obj, const string key)
{
   CFarmJsonValue *v = obj.Get(key);
   return (v != NULL && v.type == FARM_JSON_BOOL && v.bool_value);
}

void FarmFillStatePosition(CFarmJsonValue *src, FarmStatePosition &out)
{
   out.ticket = FarmJsonLongValue(src, "ticket");
   out.symbol = FarmJsonStringValue(src, "symbol");
   out.side = FarmJsonStringValue(src, "side");
   out.volume = FarmJsonNumberValue(src, "volume");
   out.price_open = FarmJsonNumberValue(src, "price_open");
   CFarmJsonValue *sl = src.Get("sl");
   out.sl_is_null = (sl != NULL && sl.type == FARM_JSON_NULL);
   out.sl = (sl != NULL && sl.type == FARM_JSON_NUMBER ? sl.number_value : 0.0);
   CFarmJsonValue *tp = src.Get("tp");
   out.tp_is_null = (tp != NULL && tp.type == FARM_JSON_NULL);
   out.tp = (tp != NULL && tp.type == FARM_JSON_NUMBER ? tp.number_value : 0.0);
   out.profit = FarmJsonNumberValue(src, "profit");
   out.swap = FarmJsonNumberValue(src, "swap");
   out.magic = FarmJsonLongValue(src, "magic");
   CFarmJsonValue *comment = src.Get("comment");
   out.comment_present = (comment != NULL);
   out.comment_is_null = (comment != NULL && comment.type == FARM_JSON_NULL);
   out.comment = (comment != NULL && comment.type == FARM_JSON_STRING ? comment.string_value : "");
   out.time_open = FarmJsonStringValue(src, "time_open");
}

void FarmFillStatePendingOrder(CFarmJsonValue *src, FarmStatePendingOrder &out)
{
   out.ticket = FarmJsonLongValue(src, "ticket");
   out.symbol = FarmJsonStringValue(src, "symbol");
   out.type = FarmJsonStringValue(src, "type");
   out.volume = FarmJsonNumberValue(src, "volume");
   out.price_open = FarmJsonNumberValue(src, "price_open");
   CFarmJsonValue *sl = src.Get("sl");
   out.sl_present = (sl != NULL);
   out.sl_is_null = (sl != NULL && sl.type == FARM_JSON_NULL);
   out.sl = (sl != NULL && sl.type == FARM_JSON_NUMBER ? sl.number_value : 0.0);
   CFarmJsonValue *tp = src.Get("tp");
   out.tp_present = (tp != NULL);
   out.tp_is_null = (tp != NULL && tp.type == FARM_JSON_NULL);
   out.tp = (tp != NULL && tp.type == FARM_JSON_NUMBER ? tp.number_value : 0.0);
   out.magic = FarmJsonLongValue(src, "magic");
   out.time_setup = FarmJsonStringValue(src, "time_setup");
   CFarmJsonValue *exp = src.Get("time_expiration");
   out.time_expiration_present = (exp != NULL);
   out.time_expiration_is_null = (exp != NULL && exp.type == FARM_JSON_NULL);
   out.time_expiration = (exp != NULL && exp.type == FARM_JSON_STRING ? exp.string_value : "");
}

void FarmFillStringArray(CFarmJsonValue *src, string &out[])
{
   ArrayResize(out, src.Size());
   for(int i = 0; i < src.Size(); i++)
   {
      CFarmJsonValue *item = src.At(i);
      out[i] = (item != NULL && item.type == FARM_JSON_STRING ? item.string_value : "");
   }
}

void FarmFillState(CFarmJsonValue *root, FarmStatePayload &out)
{
   out.Free();
   out.raw_json = root.ToJson();
   out.balance = FarmJsonNumberValue(root, "balance");
   out.equity = FarmJsonNumberValue(root, "equity");
   out.margin_used = FarmJsonNumberValue(root, "margin_used");
   out.margin_free = FarmJsonNumberValue(root, "margin_free");
   CFarmJsonValue *ml = root.Get("margin_level_pct");
   out.margin_level_pct_present = (ml != NULL);
   out.margin_level_pct_is_null = (ml != NULL && ml.type == FARM_JSON_NULL);
   out.margin_level_pct = (ml != NULL && ml.type == FARM_JSON_NUMBER ? ml.number_value : 0.0);
   out.equity_hwm = FarmJsonNumberValue(root, "equity_hwm");
   out.day_start_equity = FarmJsonNumberValue(root, "day_start_equity");
   out.day_pl = FarmJsonNumberValue(root, "day_pl");
   out.day_pl_pct = FarmJsonNumberValue(root, "day_pl_pct");
   CFarmJsonValue *positions = root.Get("positions");
   ArrayResize(out.positions, positions.Size());
   for(int i = 0; i < positions.Size(); i++) FarmFillStatePosition(positions.At(i), out.positions[i]);
   CFarmJsonValue *pending = root.Get("pending_orders");
   ArrayResize(out.pending_orders, pending.Size());
   for(int i = 0; i < pending.Size(); i++) FarmFillStatePendingOrder(pending.At(i), out.pending_orders[i]);
   CFarmJsonValue *owned_net = root.Get("owned_net");
   ArrayResize(out.owned_net_keys, owned_net.Size());
   ArrayResize(out.owned_net_values, owned_net.Size());
   for(int i = 0; i < owned_net.Size(); i++)
   {
      out.owned_net_keys[i] = owned_net.KeyAt(i);
      CFarmJsonValue *v = owned_net.At(i);
      out.owned_net_values[i] = (v != NULL && v.type == FARM_JSON_NUMBER ? v.number_value : 0.0);
   }
   CFarmJsonValue *count = root.Get("owned_ticket_count");
   ArrayResize(out.owned_ticket_count_keys, count.Size());
   ArrayResize(out.owned_ticket_count_values, count.Size());
   for(int i = 0; i < count.Size(); i++)
   {
      out.owned_ticket_count_keys[i] = count.KeyAt(i);
      CFarmJsonValue *v = count.At(i);
      out.owned_ticket_count_values[i] = (v != NULL && v.type == FARM_JSON_NUMBER ? v.integer_value : 0);
   }
   CFarmJsonValue *foreign = root.Get("foreign_positions");
   out.foreign_positions.count = FarmJsonLongValue(foreign, "count");
   FarmFillStringArray(foreign.Get("symbols"), out.foreign_positions.symbols);
   out.foreign_positions.total_volume = FarmJsonNumberValue(foreign, "total_volume");
   out.foreign_positions.margin_estimate = FarmJsonNumberValue(foreign, "margin_estimate");
   out.account_margin_mode = FarmJsonStringValue(root, "account_margin_mode");
   CFarmJsonValue *guard = root.Get("guard");
   out.guard.halted = FarmJsonBoolValue(guard, "halted");
   CFarmJsonValue *reason = guard.Get("halt_reason");
   out.guard.halt_reason_present = (reason != NULL);
   out.guard.halt_reason_is_null = (reason != NULL && reason.type == FARM_JSON_NULL);
   out.guard.halt_reason = (reason != NULL && reason.type == FARM_JSON_STRING ? reason.string_value : "");
   out.guard.mode = FarmJsonStringValue(guard, "mode");
   out.guard.current_spread_points = FarmJsonLongValue(guard, "current_spread_points");
   out.guard.internal_hedge_detected = FarmJsonBoolValue(guard, "internal_hedge_detected");
   CFarmJsonValue *until = guard.Get("halted_until");
   out.guard.halted_until_present = (until != NULL);
   out.guard.halted_until_is_null = (until != NULL && until.type == FARM_JSON_NULL);
   out.guard.halted_until = (until != NULL && until.type == FARM_JSON_STRING ? until.string_value : "");
}

bool FarmParseState(const string json, FarmStatePayload &out)
{
   CFarmJsonDoc doc;
   if(!doc.Parse(json)) return false;
   if(!FarmValidateState(doc.Root())) { doc.Free(); return false; }
   FarmFillState(doc.Root(), out);
   doc.Free();
   return true;
}

bool FarmSerializeState(const FarmStatePayload &src, string &out_json)
{
   out_json = src.raw_json;
   return out_json != "";
}

bool FarmParseHello(const string json, FarmHelloPayload &out)
{
   return FarmParsePayloadJson(FARM_MSG_HELLO, json, out.raw_json);
}

bool FarmSerializeHello(const FarmHelloPayload &src, string &out_json)
{
   out_json = src.raw_json;
   return out_json != "";
}

bool FarmParseHelloAck(const string json, FarmHelloAckPayload &out)
{
   return FarmParsePayloadJson(FARM_MSG_HELLO_ACK, json, out.raw_json);
}

